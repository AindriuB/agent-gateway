{
  "name": "agent-gateway-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "protocol",
    "module",
    "gateway"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "npm run build -w protocol && npm run build -w module && npm run build -w gateway",
    "lint": "eslint . && prettier --check \"*.{js,ts,json}\" \"{protocol,module,gateway,lang,styles,docs}/**/*.{ts,json,css}\" \"!**/dist/**\" \"!docs/plan/**\" \"!**/package-lock.json\"",
    "test": "vitest run --passWithNoTests",
    "verify": "npm run build && npm run lint && npm run test"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
