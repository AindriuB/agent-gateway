# Public domain name; its DNS A/AAAA record must point at this host (Caddy gets the certificate).
DOMAIN=gateway.example.com
# Origin of the GM's Foundry page that may open the link, e.g. https://foundry.example.com
FOUNDRY_ORIGIN=https://foundry.example.com
# Email Let's Encrypt can reach about certificate problems.
ACME_EMAIL=you@example.com
# Image version to run: ghcr.io/aindriub/foundry-agent-gateway:<GATEWAY_VERSION>. Tags are X.Y.Z and X.Y.
# To build from source instead (or for an unpublished version), run: docker compose up -d --build
GATEWAY_VERSION=0.3.0
# Optional: debug, info, warn or error.
#AGENT_GATEWAY_LOG_LEVEL=info
# Bring your own Caddy: use the gateway-only Compose file (see README).
#COMPOSE_FILE=compose.byo-caddy.yaml
# Bring your own Caddy in a container: join that container's network (find the name with docker ps).
#GATEWAY_NETWORK_MODE=container:caddy
