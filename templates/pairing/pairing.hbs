<section class="agent-gateway-pairing">
  <p class="status" data-role="status">{{status}}</p>
  <p class="hint" data-role="address">{{address}}</p>
  {{#if worldWarning}}<p class="notification warning">{{worldWarning}}</p>{{/if}}
  {{#if urlWarning}}<p class="notification warning">{{urlWarning}}</p>{{/if}}
  <div class="form-group">
    <label>{{localize "AGENT_GATEWAY.Pairing.gatewayUrl"}}</label>
    <input type="text" name="gatewayUrl" value="{{gatewayUrl}}" />
  </div>
  <div class="form-group">
    <label>{{codeLabel}}</label>
    <input type="text" name="code" autocomplete="off" />
    <p class="hint">{{codeHint}}</p>
  </div>
  <div class="form-group agent-gateway-copy-ids">
    {{#if serverMode}}<p class="hint" data-role="server">{{serverLine}}</p>{{/if}}
    <details data-role="ids-block">
      <summary>{{localize "AGENT_GATEWAY.Pairing.CopyIds.summary"}}</summary>
      <p data-role="ids">{{idsText}}</p>
      <button type="button" data-action="copyIds"><i class="fa-solid fa-copy"></i> {{localize "AGENT_GATEWAY.Pairing.CopyIds.button"}}</button>
      <p class="hint" data-role="ids-hint">{{idsHint}}</p>
    </details>
  </div>
  <p class="hint" data-role="one-pairing">{{onePairingNotice}}</p>
  <div class="form-group agent-gateway-unpair" data-role="unpair"{{#unless paired}} hidden{{/unless}}>
    <button type="button" data-action="unpair"><i class="fa-solid fa-link-slash"></i> {{localize "AGENT_GATEWAY.Pairing.Unpair.button"}}</button>
    <p class="hint">{{localize "AGENT_GATEWAY.Pairing.Unpair.hint"}}</p>
  </div>
  <footer class="form-footer">
    <button type="submit"><i class="fa-solid fa-link"></i> {{localize "AGENT_GATEWAY.Pairing.connect"}}</button>
  </footer>
</section>
